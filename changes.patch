+                video.parent.mkdir(parents=True, exist_ok=True)
+                with av.open(str(video), "w") as container:
+                    stream = container.add_stream("ffv1", rate=10)
+                    stream.width, stream.height, stream.pix_fmt = 16, 16, "bgr0"
+                    for index in range(4):
